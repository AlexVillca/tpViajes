# Copiar a .env y completar con valores reales. El .env NUNCA se commitea (está en .gitignore).
# Los valores de ejemplo de abajo sirven para desarrollo LOCAL; en producción se usan otros.

# ---- MySQL (docker-compose, desarrollo local) ----
MYSQL_PORT=3310
MYSQL_ROOT_PASSWORD=cambiar_root_local
MYSQL_DATABASE=tpviajes
MYSQL_USER=tpviajes
MYSQL_PASSWORD=cambiar_password_local

# ---- Backend (Paso 2) ----
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=tpviajes
DB_PASSWORD=cambiar_password_local
DB_NAME=tpviajes

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios). En producción, otro valor.
# El backend no arranca sin este valor ni con el de ejemplo. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Puerto del backend (por defecto 3000).
PORT=3000

# Dirección donde escucha el backend. 127.0.0.1 = solo la propia máquina; 0.0.0.0 = acepta
# conexiones de otras máquinas.
HOST=127.0.0.1

# Orígenes del frontend que pueden usar la API con la sesión, separados por coma y sin barra final.
# Sin valor solo se aceptan http://localhost:4200 y http://127.0.0.1:4200.
FRONTEND_URL=http://localhost:4200

# true cuando el frontend y la API están en dominios distintos (por ejemplo, la app local contra la
# API publicada): la cookie de sesión necesita SameSite=None y Secure, que exige HTTPS.
COOKIE_CROSS_SITE=false
