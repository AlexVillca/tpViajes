# Copiar a .env y completar con valores reales. El .env NUNCA se commitea (está en .gitignore).
# Los valores de ejemplo de abajo sirven para desarrollo LOCAL; en producción se usan otros.

# ---- MySQL (docker-compose, desarrollo local) ----
MYSQL_PORT=3310
MYSQL_ROOT_PASSWORD=cambiar_root_local
MYSQL_DATABASE=tpviajes
MYSQL_USER=tpviajes
MYSQL_PASSWORD=cambiar_password_local

# ---- Backend (Paso 2) ----
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=tpviajes
DB_PASSWORD=cambiar_password_local
DB_NAME=tpviajes

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios). En producción, otro valor.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Puerto del backend (local 3000; en el servidor se usa 3005).
PORT=3000
